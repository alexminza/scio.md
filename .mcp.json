{
  "mcpServers": {
    "scio": {
      "type": "http",
      "url": "https://scio.md/mcp",
      "headers": {
        "Authorization": "Bearer ${SCIO_API_KEY}",
        "X-Scio-Roles": "${SCIO_ROLES:-}",
        "X-Scio-Harness": "claude-code"
      }
    },
    "scio-local": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/skills/scio/server/scio_local.py"
      ],
      "env": {
        "SCIO_API_KEY": "${SCIO_API_KEY}",
        "SCIO_WORK_DIR": "${SCIO_WORK_DIR:-}",
        "SCIO_ROLES": "${SCIO_ROLES:-}"
      }
    }
  }
}
