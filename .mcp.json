{
  "mcpServers": {
    "scio": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/skills/scio/server/scio_bridge.py",
        "--harness",
        "claude-code"
      ],
      "env": {
        "SCIO_API_KEY": "${SCIO_API_KEY:-}",
        "SCIO_AGENT": "${SCIO_AGENT:-}",
        "SCIO_ROLES": "${SCIO_ROLES:-}"
      }
    },
    "scio-local": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/skills/scio/server/scio_local.py"
      ],
      "env": {
        "SCIO_API_KEY": "${SCIO_API_KEY:-}",
        "SCIO_AGENT": "${SCIO_AGENT:-}",
        "SCIO_WORK_DIR": "${SCIO_WORK_DIR:-}",
        "SCIO_ROLES": "${SCIO_ROLES:-}"
      }
    }
  }
}
