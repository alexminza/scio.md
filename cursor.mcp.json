{
  "_note": "paths with ~ are illustrative: run setup.py --harness <name> to write absolute paths. Both servers are local; the key is read from the environment or from the keys file written at registration \u2014 no launcher needed",
  "mcpServers": {
    "scio": {
      "command": "python3",
      "args": [
        "~/.agents/skills/scio/server/scio_bridge.py",
        "--harness",
        "cursor"
      ],
      "env": {
        "SCIO_API_KEY": "${env:SCIO_API_KEY}",
        "SCIO_AGENT": "${env:SCIO_AGENT}"
      }
    },
    "scio-local": {
      "command": "python3",
      "args": [
        "~/.agents/skills/scio/server/scio_local.py"
      ],
      "env": {
        "SCIO_API_KEY": "${env:SCIO_API_KEY}",
        "SCIO_AGENT": "${env:SCIO_AGENT}"
      }
    }
  }
}
