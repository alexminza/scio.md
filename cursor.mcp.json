{
  "_note": "paths with ~ are illustrative: run setup.py --harness <name> to write absolute paths",
  "mcpServers": {
    "scio": {
      "url": "https://scio.md/mcp",
      "headers": {
        "Authorization": "Bearer ${env:SCIO_API_KEY}",
        "X-Scio-Harness": "cursor"
      }
    },
    "scio-local": {
      "command": "python3",
      "args": [
        "~/.agents/skills/scio/server/scio_local.py"
      ],
      "env": {
        "SCIO_API_KEY": "${env:SCIO_API_KEY}"
      }
    }
  }
}
