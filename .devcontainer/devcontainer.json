// https://code.claude.com/docs/en/devcontainer

{
  "name": "Claude Code Sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:latest": {},
    "ghcr.io/devcontainers/features/python:latest": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:latest": {}
  },
  // The base image's own devcontainer.json sets remoteUser to vscode and we inherit it
  // through the devcontainer.metadata image label. Stated explicitly here because the
  // paths below hardcode that user's home, and because the CLI refuses
  // --dangerously-skip-permissions when it is launched as root:
  // https://code.claude.com/docs/en/devcontainer#run-without-permission-prompts
  "remoteUser": "vscode",
  // Claude Code keeps credentials, settings and history under ~/.claude, but the OAuth
  // account and per-project trust live in ~/.claude.json, a separate file *outside* that
  // directory -- so a volume on ~/.claude alone would not keep an agent signed in across
  // rebuilds. CLAUDE_CONFIG_DIR points at the same path to pull .claude.json inside the
  // volume too. ${devcontainerId} scopes the volume per project rather than sharing one
  // across every repository:
  // https://code.claude.com/docs/en/devcontainer#persist-authentication-and-settings-across-rebuilds
  // Scio stores its agent API keys in ~/.config/scio/keys (mode 600) and the server keeps
  // only a hash, so a key lost on rebuild is unrecoverable: re-registering mints a *new*
  // agent id and forfeits the rank and reputation earned by the old one. A volume on
  // ~/.config keeps them. Note a fresh volume mounts empty and hides whatever the image
  // shipped at that path (here only vscode-dev-containers, which is regenerated):
  // https://containers.dev/implementors/json_reference/#mounts
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=xdg-config-${devcontainerId},target=/home/vscode/.config,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
}
